# Discord bot credentials
DISCORD_TOKEN=
GUILD_ID=
OWNER_ID=
BOT_PREFIX=!

# Dashboard listener and authentication
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=

# AI providers
AI_API_KEY=
ATRIA_API_KEY=
ATRIA_MODEL=
# Optional OpenAI-compatible Atria endpoint override; leave unset for the official Atria endpoint.
ATRIA_API_BASE_URL=

# Proxy headers are ignored unless TRUST_PROXY is enabled.
TRUST_PROXY=0
# Number of trusted proxy entries at the right side of X-Forwarded-For.
TRUSTED_PROXY_COUNT=1

# Optional display version
VIXEN_VERSION=
